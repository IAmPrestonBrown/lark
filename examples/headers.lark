/* Reading C headers directly.
 *
 * Rule C-1 sends every `#include` to the platform preprocessor, and rule N-12
 * puts the names it finds in this module. So `printf` needs no `@import`, and
 * `size_t` is a real type name that a cast can use. Rule L-6 needs that name,
 * because `(size_t) x` and `(value) * x` differ only by what `size_t` is.
 *
 * Compare `examples/stdio.lark`, which declares the same functions by hand.
 * That file exists for a program that cannot reach a C compiler.
 */

#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* A managed struct still works beside the C names. */
managed struct Greeting {
    const char *who;
    int count;
};

static void say(gc Greeting *greeting)
{
    for (int i = 0; i < greeting->count; i = i + 1) {
        printf("hello %s\n", greeting->who);
    }
}

init int main(void)
{
    const char *name = "Lark";
    size_t length = strlen(name);

    auto greeting = new Greeting { .who = name, .count = 2 };
    say(greeting);

    /* `stdout` is a macro, not a declaration. Rule C-1c keeps it in the table. */
    fprintf(stdout, "%s has %zu bytes\n", name, length);

    if (length != (size_t) 4) {
        return EXIT_FAILURE;
    }
    return EXIT_SUCCESS;
}
