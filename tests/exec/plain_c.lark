// A plain C11 file, compiled by Lark with no change.
//
// Rule S-1 promises that Lark is a superset of C11. This file uses no Lark
// construct at all. It holds a macro, an old style definition, a generic
// selection, a static assertion, and a designated initializer.
// covers: S-1, C-2a, C-3a
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define LIMIT 8
#define SQUARE(x) ((x) * (x))

typedef struct point {
    int x;
    int y;
}
point;

static int compare_int(const void* left, const void* right)
{
    const int* a = left;
    const int* b = right;
    return (* a > * b) -(* a < * b);
}

static int sum(const int* values, size_t count)
{
    int total = 0;
    for (size_t i = 0; i < count; i += 1) {
        total += values[i];
    }
    return total;
}

/* An old style definition. C11 6.9.1. */
int add(a, b)
int a;
int b;
{
    return a + b;
}

int main(void)
{
    int values[LIMIT] = { 5, 3, 9, 1, 7, 2, 8, 4 };
    int ranged[6] = { [0 ... 2] = 1, [3] = 4 };
    point origin = { .x = 1, .y = 2 };
    char label[16];

    _Static_assert(LIMIT == 8, "the array holds eight items");
    qsort(values, LIMIT, sizeof (int), compare_int);
    strcpy(label, "totals");

    printf("%s %d %d\n", label, sum(values, LIMIT), SQUARE(3));
    printf("sorted %d %d %d\n", values[0], values[3], values[LIMIT - 1]);
    printf("point %d %d add %d\n", origin.x, origin.y, add(4, 5));
    printf("kind %d ranged %d\n", _Generic(origin.x, int : 1, default :
    0), sum(ranged, 6));
    return EXIT_SUCCESS;
}
